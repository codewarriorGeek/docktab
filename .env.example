# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Sandbox test accounts used by the demo (developer.paypal.com > Testing Tools > Sandbox Accounts)
PAYPAL_MERCHANT_EMAIL=your-business-account@business.example.com
PAYPAL_BROKER_EMAIL=your-broker-account@personal.example.com
PAYPAL_LUMPER_EMAIL=your-lumper-account@personal.example.com
# AI service used by the agent
AI_SERVICE_API_KEY=
# Optional: model name and effort (defaults in src/lib/agent.ts)
AI_MODEL_NAME=
AI_MODEL_EFFORT=
